{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["firefox-webext-browser"]
  },
  "include": ["src/**/*.ts", "../src/core/protocol.ts", "../src/core/version.ts"],
  "exclude": ["dist", "../dist", "../node_modules", "../tests"]
}
